APP_NAME="The Business Clinic.Africa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tbca.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"

# --- Zoho One integration (off until credentials exist) ---------------------
# OAuth credentials come from the Zoho API console (Self Client or Server-based
# client). Never put a Zoho user password here.
ZOHO_ENABLED=false
ZOHO_DC=eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_BANK_ACCOUNT_ID=
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=
ZOHO_PROJECTS_PORTAL_ID=
ZOHO_PROJECTS_TEMPLATE_ID=
ZOHO_WORKDRIVE_PARENT_FOLDER_ID=
ZOHO_CREATOR_OWNER=
ZOHO_CREATOR_APP=tbca-operations
ZOHO_BILLING_ORG_ID=
ZOHO_CRM_PIPELINE=
ZOHO_WEBHOOK_SECRET=
ZOHO_FLOW_AWAIT_CONFIRMATION=false
ZOHO_FLOW_ENQUIRY_URL=
ZOHO_FLOW_WEBINAR_URL=
ZOHO_FLOW_ORDER_PAID_URL=
ZOHO_FLOW_DD_CASE_URL=
ZOHO_FLOW_VDR_ENQUIRY_URL=
ZOHO_FLOW_SUPPORT_URL=

# --- Identity verification for Due Diligence -------------------------------
# simulated (default, no network) or vove
IDENTITY_VERIFICATION_DRIVER=simulated
IDENTITY_VERIFICATION_AUTO_START=false
VOVE_ENVIRONMENT=Sandbox
VOVE_API_BASE_URL=https://api.voveid.net
VOVE_HOSTED_URL=https://web.voveid.net
VOVE_API_KEY=
VOVE_PUBLIC_KEY=
VOVE_WEBHOOK_SECRET=
VOVE_KYC_FLOW_ID=
VOVE_KYC_ADDRESS_FLOW_ID=
VOVE_AML_INDIVIDUAL_FLOW_ID=
VOVE_AML_ENTITY_FLOW_ID=
VOVE_KYB_FLOW_ID=
